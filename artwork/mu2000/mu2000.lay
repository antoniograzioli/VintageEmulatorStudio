<?xml version="1.0"?>
<!--
license:CC0-1.0
authors:hap, Felipe Sanches
-->
<mamelayout version="2">

<!-- define elements -->

<element name="panel">
    <image file="mu2000.png"/>
</element>


	<element name="led" defstate="0">
		<disk state="0"><color red="0.07" green="0.1" blue="0.02" alpha ="0.0"/></disk>
		<disk state="1"><color red="0.7" green="1.0" blue="0.2" alpha="0.5"/></disk>
	</element>

	<element name="ledred" defstate="0">
		<disk state="0"><color red="0.1" green="0" blue="0.02" alpha ="0.0"/></disk>
		<disk state="1"><color red="1.0" green="0" blue="0.2" alpha="0.5"/></disk>
	</element>

	<element name="ledr" defstate="0">
		<rect state="0"><color red="0.7" green="0.8" blue="0.2" alpha="0.0"/></rect>
		<rect state="1"><color red="0.7" green="1.0" blue="0.2" alpha="0.5"/></rect>
	</element>

	<element name="round_white_button">
		<disk state="0">
			<color red="0.82" green="0.86" blue="0.86" alpha="0.00"/>
		</disk>

		<disk state="0">
			 <color red="0.35" green="0.35" blue="0.35" alpha="0.12"/>
		</disk>
	</element>

	<element name="round_gray_highlight">
		<disk>
			<color red="0.3" green="0.3" blue="0.3" />
		</disk>
	</element>

	<element name="rect_white_button">
		 <!-- Normale: invisibile -->
    <rect state="0">
        <color red="0.82" green="0.86" blue="0.86" alpha="0.00"/>
    </rect>

    <!-- Premuto: leggerissimo grigio -->
    <rect state="1">
        <color red="0.35" green="0.35" blue="0.35" alpha="0.12"/>
    </rect>
	</element>

	<element name="rect_yellow_button">
			 <!-- Normale: invisibile -->
    <rect state="0">
        <color red="0.82" green="0.86" blue="0.86" alpha="0.00"/>
    </rect>

    <!-- Premuto: leggerissimo grigio -->
    <rect state="1">
        <color red="0.35" green="0.35" blue="0.35" alpha="0.12"/>
    </rect>
	</element>

<element name="lcda" defstate="0">
    <rect>
        <color state="0"
               red="0.0"
               green="0.0"
               blue="0.0"
               alpha="0.0" />

        <!-- Highlight molto più delicato -->
        <color state="7"
               red="0.60"
               green="0.66"
               blue="0.40"
               alpha="0.06" />
    </rect>
</element>

<element name="lcdm">
    <rect>
        <!-- Verde oliva più scuro -->
        <color red="0.46"
               green="0.54"
               blue="0.30"
               alpha="0.82" />
    </rect>
</element>
	


	


<!-- build screen -->

	<view name="Internal Layout">
		<bounds x="0" y="0" width="1640" height="680" />




    <bounds x="0" y="0" width="1640" height="790"/>

    <!-- Sfondo -->
    <element ref="panel">
        <bounds x="0" y="0" width="1640" height="680"/>
    </element>

   







    <!-- Display -->
   

		<screen index="0"><bounds x="412" y="94" width="700" height="212" /></screen>

		<element name="contrast" ref="lcda" blend="add"><bounds x="412" y="94" width="700" height="212" /></element>

		<element ref="lcdm" blend="multiply"><bounds x="412" y="94" width="700" height="212" /></element>




<!-- LEDS -->



		
		<element name="LED0" ref="led" inputtag="SWS3" inputmask="0x80"><!-- PLAY --><bounds x="1255" y="108" width="30" height="30" /></element>

		
		<element name="LED1" ref="led" inputtag="SWS3" inputmask="0x40"><!-- EDIT --><bounds x="1325" y="108" width="30" height="30" /></element>

		
		<element name="LED2" ref="led" inputtag="SWS3" inputmask="0x20"><!-- UTIL --><bounds x="1255" y="187" width="30" height="30" /></element>

		
		<element name="LED3" ref="led" inputtag="SWS3" inputmask="0x10"><!-- EFFECT --><bounds x="1325" y="187" width="30" height="30" /></element>

		
		<element name="LED4" ref="ledred" inputtag="SWS5" inputmask="0x80"><!-- SAMPLING --><bounds x="1255" y="267" width="30" height="30" /></element>

		
		<element name="LED5" ref="led" inputtag="SWS4" inputmask="0x80"><!-- SEQ --><bounds x="1325" y="267" width="30" height="30" /></element>






		

		<!-- BUTTONS ROW 1-->
		
		<element ref="rect_yellow_button" inputtag="SWS0" inputmask="0x80"><bounds x="435" y="383" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS0" inputmask="0x40"><bounds x="526" y="383" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS0" inputmask="0x20"><bounds x="618" y="383" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS0" inputmask="0x10"><bounds x="706" y="383" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS0" inputmask="0x08"><bounds x="798" y="383" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS0" inputmask="0x04"><bounds x="890" y="383" width="74" height="28"/></element>

<!-- BUTTONS ROW 2-->
		
		<element ref="rect_yellow_button" inputtag="SWS1" inputmask="0x80"><bounds x="435" y="454" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS1" inputmask="0x40"><bounds x="526" y="454" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS1" inputmask="0x20"><bounds x="618" y="454" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS1" inputmask="0x10"><bounds x="706" y="454" width="74" height="28"/></element>

		<element ref="rect_yellow_button" inputtag="SWS1" inputmask="0x08"><bounds x="798" y="454" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS1" inputmask="0x04"><bounds x="890" y="454" width="74" height="28"/></element>

<!-- BUTTONS ROW 3-->
		
		<element ref="rect_yellow_button" inputtag="SWS2" inputmask="0x80"><bounds x="435" y="522" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS2" inputmask="0x40"><bounds x="526" y="522" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS2" inputmask="0x20"><bounds x="618" y="522" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS2" inputmask="0x10"><bounds x="706" y="522" width="74" height="28"/></element>

		<element ref="rect_yellow_button" inputtag="SWS2" inputmask="0x08"><bounds x="798" y="522" width="74" height="28"/></element>

		
		<element ref="rect_yellow_button" inputtag="SWS2" inputmask="0x04"><bounds x="890" y="522" width="74" height="28"/></element>







<!-- GREY BUTTON ROW 1-->
		<element ref="rect_white_button" inputtag="SWS3" inputmask="0x08"><!-- MUTE/SOLO --><bounds x="1395" y="103" width="55" height="55"/></element>
		
		<element ref="rect_white_button" inputtag="SWS3" inputmask="0x04"><!-- PART - --><bounds x="1465" y="103" width="55" height="55"/></element>
		

		<element ref="rect_white_button" inputtag="SWS3" inputmask="0x02"><!-- PART + --><bounds x="1532" y="103" width="55" height="55"/></element>
		

<!-- GREY BUTTON ROW 2-->
		<element ref="rect_white_button" inputtag="SWS4" inputmask="0x40"><!-- ENTER --><bounds x="1395" y="178" width="55" height="55"/></element>
		
		<element ref="rect_white_button" inputtag="SWS4" inputmask="0x20"><!-- SELECT < --><bounds x="1465" y="178" width="55" height="55"/></element>
		

		<element ref="rect_white_button" inputtag="SWS4" inputmask="0x10"><!-- SELECT > --><bounds x="1532" y="178" width="55" height="55"/></element>
		

<!-- GREY BUTTON ROW 3-->

		<element ref="rect_white_button" inputtag="SWS4" inputmask="0x08"><!-- EXIT --><bounds x="1395" y="253" width="55" height="55"/></element>
		
		<element ref="rect_white_button" inputtag="SWS4" inputmask="0x04"><!-- VALUE - --><bounds x="1465" y="253" width="55" height="55"/></element>
		
		<element ref="rect_white_button" inputtag="SWS4" inputmask="0x02"><!-- VALUE + --><bounds x="1532" y="253" width="55" height="55"/></element>
		

		<element ref="round_white_button" inputtag="SWS5" inputmask="0x40"><!-- SELECT --><bounds x="1175" y="441" width="40" height="40"/></element>
		<element ref="round_white_button" inputtag="SWS5" inputmask="0x20"><!-- AUDITION --><bounds x="1263" y="441" width="40" height="40"/></element>




		

		
		
		<element name="LED6" ref="ledr"><!-- MU --><bounds x="761" y="606" width="37" height="26" /></element>
		<element name="LED7" ref="ledr"><!-- PLG-1 --><bounds x="832" y="606" width="37" height="26" /></element>
		<element name="LED8" ref="ledr"><!-- PLG-2 --><bounds x="911" y="606" width="37" height="26" /></element>
		<element name="LED9" ref="ledr"><!-- PLG-3 --><bounds x="989" y="606" width="37" height="26" /></element>
	</view>

</mamelayout>

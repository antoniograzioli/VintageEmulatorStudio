<?xml version="1.0"?>
<!--
license:CC0-1.0
authors:hap, Felipe Sanches, autodafe-->
<mamelayout version="2">

<!-- define elements -->
	<element name="cpanel"><image file="mu50.png"/></element>

	<element name="led" defstate="0">
		<disk state="0"><color red="0.38" green="0.45" blue="0.39" alpha="0.1" /></disk>
		<disk state="1"><color red="0.43" green="1.00" blue="0.29" alpha="0.25" /></disk>
	</element>

	<element name="ledred" defstate="0">
		<disk state="0"><color red="0.45" green="0.38" blue="0.39" /></disk>
		<disk state="1"><color red="1.00" green="0" blue="0.2" /></disk>
	</element>

	<element name="ledr" defstate="0">
		<rect state="0"><color red="0.38" green="0.45" blue="0.39" /></rect>
		<rect state="1"><color red="0.43" green="1.00" blue="0.29" /></rect>
	</element>

	




	<element name="rect_white_button">
		

		<disk state="0">
        <color red="0.0" green="0.0" blue="0.0" alpha="0.0"/>
    </disk>

    <disk state="1">
        <color red="0.2" green="0.6" blue="1.0" alpha="0.1"/>
    </disk>
	</element>
	

	<element name="lcda" defstate="0">
		<rect>
			<color state="0"
               red="0.0"
               green="0.0"
               blue="0.0"
               alpha="0.0" />

        <!-- Highlight molto più delicato -->
        <color state="7"
               red="0.60"
               green="0.66"
               blue="0.40"
               alpha="0.06" />
		</rect>
	</element>

	<element name="lcdm">
	 <rect>
        <!-- Verde oliva più scuro -->
        <color red="0.46"
               green="0.54"
               blue="0.30"
               alpha="0.82" />
    </rect></element>

<!-- build screen -->

	<view name="External Layout">
		<bounds x="0" y="0" width="1640" height="390" />
		<element ref="cpanel"><bounds left="0" right="1640" top="0" bottom="390"/></element>

		<screen index="0"><bounds x="413" y="123" width="651" height="138" /></screen>
		<element name="contrast" ref="lcda" blend="add"><bounds x="413" y="123" width="651" height="138" /></element>
		<element ref="lcdm" blend="multiply"><bounds x="413" y="123" width="651" height="138" /></element>

		<element name="LED0" ref="led" inputtag="O0" inputmask="0x04"><!-- PLAY --><bounds x="1195" y="125" width="30" height="30" /></element>
		<element name="LED1" ref="led" inputtag="O0" inputmask="0x08"><!-- EDIT --><bounds x="1269" y="125" width="30" height="30" /></element>
		<element name="LED2" ref="led" inputtag="O1" inputmask="0x04"><!-- UTIL --><bounds x="1195" y="182" width="30" height="30" /></element>
		<element name="LED3" ref="led" inputtag="O1" inputmask="0x08"><!-- EFFECT --><bounds x="1269" y="182" width="30" height="30" /></element>
		<element name="LED4" ref="led" inputtag="O2" inputmask="0x04"><!-- MODE --><bounds x="1195" y="240" width="30" height="30" /></element>








		<element ref="rect_white_button" inputtag="O0" inputmask="0x10"><!-- MUTE/SOLO --><bounds x="1380" y="112" width="38" height="38"/></element>
		<element ref="rect_white_button" inputtag="O0" inputmask="0x20"><!-- PART - --><bounds x="1463" y="112" width="38" height="38"/></element>
		<element ref="rect_white_button" inputtag="O0" inputmask="0x40"><!-- PART + --><bounds x="1535" y="112" width="38" height="38"/></element>

		<element ref="rect_white_button" inputtag="O1" inputmask="0x10"><!-- ENTER --><bounds x="1380" y="177" width="38" height="38"/></element>
		<element ref="rect_white_button" inputtag="O1" inputmask="0x20"><!-- SELECT < --><bounds x="1463" y="177" width="38" height="38"/></element>
		<element ref="rect_white_button" inputtag="O1" inputmask="0x40"><!-- SELECT > --><bounds x="1535" y="177" width="38" height="38"/></element>

		<element ref="rect_white_button" inputtag="O2" inputmask="0x10"><!-- EXIT --><bounds x="1380" y="235" width="38" height="38"/></element>
		<element ref="rect_white_button" inputtag="O2" inputmask="0x20"><!-- VALUE - --><bounds x="1463" y="235" width="38" height="38"/></element>
		<element ref="rect_white_button" inputtag="O2" inputmask="0x40"><!-- VALUE + --><bounds x="1535" y="235" width="38" height="38"/></element>
	</view>

</mamelayout>

+	static std::size_t texture_pixel_size(u32 format)
+	{
+		return (format == TEXFORMAT_PALETTE16 || format == TEXFORMAT_YUY16) ? sizeof(std::uint16_t) : sizeof(std::uint32_t);
+	}

+#if defined(VES_VIRTUAL_MIDI_RETROFIT)
+void prophet5_state::virtual_midi_rxrdy_w(int state)
+{
+	if (state)
+		virtual_midi_byte_w(m_virtual_midi_uart->data_r());
+}
+
+void prophet5_state::virtual_midi_note_w(u8 note, bool pressed)
+{
+	if (note < 36 || note > 96)
+		return;
+
+	const u8 index = note - 36;
+	const u8 row = 8 + index / 8;
+	const u8 mask = u8(1) << (index % 8);
+	u8 &count = m_virtual_midi_note_counts[index];
+
+	if (pressed)
+	{
+		if (count != 0xff)
+			++count;
+		m_virtual_midi_rows[row - 8] |= mask;
+	}
+	else if (count && --count == 0)
+	{
+		m_virtual_midi_rows[row - 8] &= ~mask;
+	}
+}
+
+void prophet5_state::clear_virtual_midi_state()
+{
+	m_virtual_midi_rows.fill(0);
+	m_virtual_midi_note_counts.fill(0);
+	m_virtual_midi_running_status = 0;
+	m_virtual_midi_data[0] = 0;
+	m_virtual_midi_data[1] = 0;
+	m_virtual_midi_data_count = 0;
+}
+
+void prophet5_state::virtual_midi_byte_w(u8 data)
+{
+	// System real-time messages may occur anywhere and do not cancel running status.
+	if (data >= 0xf8)
+		return;
+
+	if (data & 0x80)
+	{
+		// This retrofit is omni and supports channel voice messages only.  Clearing
+		// running status here also safely discards system-common/SysEx payload data.
+		m_virtual_midi_running_status = data < 0xf0 ? data : 0;
+		m_virtual_midi_data_count = 0;
+		return;
+	}
+
+	if (!m_virtual_midi_running_status)
+		return;
+
+	const u8 message_type = m_virtual_midi_running_status & 0xf0;
+	const u8 data_size = (message_type == 0xc0 || message_type == 0xd0) ? 1 : 2;
+	m_virtual_midi_data[m_virtual_midi_data_count++] = data;
+	if (m_virtual_midi_data_count != data_size)
+		return;
+
+	if (message_type == 0x80)
+		virtual_midi_note_w(m_virtual_midi_data[0], false);
+	else if (message_type == 0x90)
+		virtual_midi_note_w(m_virtual_midi_data[0], m_virtual_midi_data[1] != 0);
+	else if (message_type == 0xb0
+		&& (m_virtual_midi_data[0] == 120 || m_virtual_midi_data[0] == 123))
+	{
+		m_virtual_midi_rows.fill(0);
+		m_virtual_midi_note_counts.fill(0);
+	}
+
+	// Retain running status after a complete channel message. Unsupported channel
+	// messages are deliberately consumed without affecting the virtual keyboard.
+	m_virtual_midi_data_count = 0;
+}
+#endif

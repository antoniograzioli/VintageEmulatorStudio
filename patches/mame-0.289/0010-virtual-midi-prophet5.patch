 void prophet5_state::prophet5rev30(machine_config &config)
 {
 	Z80(config, m_maincpu, 5_MHz_XTAL / 2);  // Divided by U325.
 	m_maincpu->set_addrmap(AS_PROGRAM, &prophet5_state::memory_map);
 	m_maincpu->set_addrmap(AS_IO, &prophet5_state::io_map);
 
+#if defined(VES_VIRTUAL_MIDI_RETROFIT)
+	// VES Virtual MIDI Retrofit. This is intentionally non-historical:
+	// it decodes the standard MAME MIDI input stream and contributes key states
+	// only to the Prophet's pre-existing scanned keyboard matrix.
+	I8251(config, m_virtual_midi_uart, 0);
+	m_virtual_midi_uart->rxrdy_handler().set(FUNC(prophet5_state::virtual_midi_rxrdy_w));
+	CLOCK(config, "ves_virtual_midi_clock", 500_kHz_XTAL)
+		.signal_handler().set(m_virtual_midi_uart, FUNC(i8251_device::write_rxc));
+	MIDI_PORT(config, "ves_virtual_midiin", midiin_slot, "midiin")
+		.rxd_handler().set(m_virtual_midi_uart, FUNC(i8251_device::write_rxd));
+#endif
+
 	NVRAM(config, "nvram", nvram_device::DEFAULT_ALL_0);
 
 	auto &pit = PIT8253(config, "tune_pit");  // U315

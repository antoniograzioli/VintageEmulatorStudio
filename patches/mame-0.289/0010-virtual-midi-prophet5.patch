 void prophet5_state::machine_reset()
 {
+#if defined(VES_VIRTUAL_MIDI_RETROFIT)
+	clear_virtual_midi_state();
+	// 31.25 kbit/s MIDI is 8-N-1. The UART receives it at 16x bit rate.
+	m_virtual_midi_uart->control_w(0x4e);
+	m_virtual_midi_uart->control_w(0x04);
+#endif
 	update_nvram_record();
 	m_misc_latch->write(0x00);  // /CLR input tied to /RESET.
 }
 
+#if defined(VES_VIRTUAL_MIDI_RETROFIT)
+void prophet5_state::virtual_midi_machine_stop()
+{
+	clear_virtual_midi_state();
+}

diff --git a/src/ves/embeddedinstruments/EmbeddedEmulatorEngine.cpp b/src/ves/embeddedinstruments/EmbeddedEmulatorEngine.cpp
index 0f32a70..1bb0d44 100644
--- a/src/ves/embeddedinstruments/EmbeddedEmulatorEngine.cpp
+++ b/src/ves/embeddedinstruments/EmbeddedEmulatorEngine.cpp
@@ -62,6 +62,7 @@ GAME_EXTERN(pss21);
 GAME_EXTERN(pss31);
 GAME_EXTERN(prophet5r30);
 GAME_EXTERN(rz1);
+GAME_EXTERN(s3000xl);
 GAME_EXTERN(sd132);
 GAME_EXTERN(sixtrak);
 GAME_EXTERN(tr707);
@@ -104,6 +105,7 @@ const game_driver *const driver_list::s_drivers_sorted[] =
 	&GAME_NAME(pss31),
 	&GAME_NAME(pss6),
 	&GAME_NAME(rz1),
+	&GAME_NAME(s3000xl),
 	&GAME_NAME(sd132),
 	&GAME_NAME(sixtrak),
 	&GAME_NAME(tg100),
@@ -1406,7 +1408,14 @@ private:
 			args.emplace_back("-artpath");
 			args.emplace_back(settings.artwork_path);
 		}
-
+		for (const auto &media : settings.startup_media_options)
+		{
+			if (!media.option_name.empty() && !media.path.empty())
+			{
+				args.emplace_back("-" + media.option_name);
+				args.emplace_back(media.path);
+			}
+		}
 		options.parse_command_line(args, OPTION_PRIORITY_CMDLINE);
 		const auto selected_driver_index = driver_list::find(settings.driver_name.c_str());
 		const auto &option_driver = selected_driver_index >= 0 ? driver_list::driver(selected_driver_index) : GAME_NAME(tx81z);
diff --git a/src/ves/embeddedinstruments/EmbeddedEmulatorEngine.h b/src/ves/embeddedinstruments/EmbeddedEmulatorEngine.h
index 3bc84a2..d7646f6 100644
--- a/src/ves/embeddedinstruments/EmbeddedEmulatorEngine.h
+++ b/src/ves/embeddedinstruments/EmbeddedEmulatorEngine.h
@@ -192,6 +192,12 @@ struct EmbeddedEmulatorEngineSettings
 	std::string artwork_path;
 	std::string driver_name = "tx81z";
 	int sample_rate = 48000;
+	struct StartupMediaOption
+	{
+		std::string option_name;
+		std::string path;
+	};
+	std::vector<StartupMediaOption> startup_media_options;
 };
 
 class EmbeddedEmulatorEngine

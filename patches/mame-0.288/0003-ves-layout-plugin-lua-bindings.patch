+#if defined(VES_LAYOUT_PLUGIN_SUPPORT)
+//-------------------------------------------------
+//  initialize_layout_input - layout-facing input
+//  bindings for the VES embedded host
+//-------------------------------------------------
+void lua_engine::initialize_layout_input(sol::table &emu)
+{
+	auto ioport_port_type = sol().registry().new_usertype<ioport_port>("ioport_port", sol::no_constructor);
+	ioport_port_type["read"] = &ioport_port::read;
+	ioport_port_type["fields"] = sol::property(
+			[this] (ioport_port &p)
+			{
+				sol::table fields = sol().create_table();
+				for (ioport_field &field : p.fields())
+					if (field.type_class() != INPUT_CLASS_INTERNAL)
+						fields[field.name()] = &field;
+				return fields;
+			});
+
+	auto ioport_field_type = sol().registry().new_usertype<ioport_field>("ioport_field", sol::no_constructor);
+	ioport_field_type.set_function("set_value", &ioport_field::set_value);
+	ioport_field_type.set_function("clear_value", &ioport_field::clear_value);
+	ioport_field_type["port"] = sol::property(&ioport_field::port);
+	ioport_field_type["minvalue"] = sol::property(
+			[] (ioport_field const &field) -> std::optional<ioport_value>
+			{
+				return (field.is_analog() || (field.type() == IPT_ADJUSTER)) ? std::optional<ioport_value>(field.minval()) : std::nullopt;
+			});
+	ioport_field_type["maxvalue"] = sol::property(
+			[] (ioport_field const &field) -> std::optional<ioport_value>
+			{
+				return (field.is_analog() || (field.type() == IPT_ADJUSTER)) ? std::optional<ioport_value>(field.maxval()) : std::nullopt;
+			});
+	ioport_field_type["centerdelta"] = sol::property(
+			[] (ioport_field const &field) -> std::optional<s32>
+			{
+				analog_field const *const analog = field.live().analog;
+				return analog ? std::optional<s32>(analog->centerdelta()) : std::nullopt;
+			});
+	ioport_field_type["is_analog"] = sol::property(&ioport_field::is_analog);
+	ioport_field_type["user_value"] = sol::property(
+			[] (ioport_field const &field)
+			{
+				ioport_field::user_settings settings;
+				field.get_user_settings(settings);
+				return settings.value;
+			},
+			[] (ioport_field &field, ioport_value value)
+			{
+				ioport_field::user_settings settings;
+				field.get_user_settings(settings);
+				settings.value = value;
+				field.set_user_settings(settings);
+			});
+}
+#endif

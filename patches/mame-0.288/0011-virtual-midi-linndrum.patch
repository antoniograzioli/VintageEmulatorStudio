+#if defined(VES_VIRTUAL_MIDI_RETROFIT)
+void linndrum_state::virtual_midi_rxrdy_w(int state)
+{
+	if (state)
+		virtual_midi_byte_w(m_virtual_midi_uart->data_r());
+}
+
+void linndrum_state::virtual_midi_note_w(u8 note)
+{
+	for (std::size_t i = 0; i < VIRTUAL_MIDI_PADS.size(); ++i)
+	{
+		const virtual_midi_pad &pad = VIRTUAL_MIDI_PADS[i];
+		if (pad.midi_note != note)
+			continue;
+
+		m_virtual_midi_columns[pad.column] |= pad.mask;
+		m_virtual_midi_pad_active[i] = true;
+		// Restarting an active pulse keeps rapid repeated Note On events visible
+		// to the firmware without bypassing its own switch/debounce handling.
+		m_virtual_midi_pad_timers[i]->adjust(attotime::from_msec(kPadPulseMs), i);
+		return;
+	}
+}
+
+TIMER_CALLBACK_MEMBER(linndrum_state::virtual_midi_pad_release)
+{
+	const std::size_t index = u32(param);
+	if (index >= VIRTUAL_MIDI_PADS.size())
+		return;
+
+	const virtual_midi_pad &pad = VIRTUAL_MIDI_PADS[index];
+	m_virtual_midi_columns[pad.column] &= ~pad.mask;
+	m_virtual_midi_pad_active[index] = false;
+}
+
+void linndrum_state::clear_virtual_midi_pads()
+{
+	m_virtual_midi_columns.fill(0);
+	m_virtual_midi_pad_active.fill(false);
+
+	for (emu_timer *timer : m_virtual_midi_pad_timers)
+		if (timer)
+			timer->adjust(attotime::never);
+}
+
+void linndrum_state::clear_virtual_midi_state()
+{
+	clear_virtual_midi_pads();
+	m_virtual_midi_running_status = 0;
+	m_virtual_midi_data[0] = 0;
+	m_virtual_midi_data[1] = 0;
+	m_virtual_midi_data_count = 0;
+}
+
+void linndrum_state::virtual_midi_byte_w(u8 data)
+{
+	// System real-time messages may occur anywhere and do not cancel running status.
+	if (data >= 0xf8)
+		return;
+
+	if (data & 0x80)
+	{
+		// This retrofit is omni and supports channel voice messages only. Clearing
+		// running status here also safely discards system-common/SysEx payload data.
+		m_virtual_midi_running_status = data < 0xf0 ? data : 0;
+		m_virtual_midi_data_count = 0;
+		return;
+	}
+
+	if (!m_virtual_midi_running_status)
+		return;
+
+	const u8 message_type = m_virtual_midi_running_status & 0xf0;
+	const u8 data_size = (message_type == 0xc0 || message_type == 0xd0) ? 1 : 2;
+	m_virtual_midi_data[m_virtual_midi_data_count++] = data;
+	if (m_virtual_midi_data_count != data_size)
+		return;
+
+	if (message_type == 0x90 && m_virtual_midi_data[1] != 0)
+		virtual_midi_note_w(m_virtual_midi_data[0]);
+	else if (message_type == 0xb0
+		&& (m_virtual_midi_data[0] == 120 || m_virtual_midi_data[0] == 123))
+	{
+		clear_virtual_midi_pads();
+	}
+
+	// Retain running status after a complete channel message. Unsupported channel
+	// messages, Note Off, and velocity-zero Note On are deliberately consumed.
+	m_virtual_midi_data_count = 0;
+}
+
+void linndrum_state::virtual_midi_machine_stop()
+{
+	clear_virtual_midi_state();
+}
+#endif

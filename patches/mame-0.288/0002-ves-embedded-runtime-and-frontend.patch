+void ves_embedded_midi_device_delivered(std::uint8_t, double machine_time_seconds)
+{
+	if (ves::g_active_diag == nullptr)
+		return;
+
+	const auto machine_ms = static_cast<std::uint64_t>(machine_time_seconds * 1000.0);
+	if (ves::g_active_diag->midi_device_first_delivered_machine_ms.load(std::memory_order_relaxed) == 0)
+		ves::g_active_diag->midi_device_first_delivered_machine_ms.store(machine_ms, std::memory_order_relaxed);
+	ves::g_active_diag->midi_device_last_delivered_machine_ms.store(machine_ms, std::memory_order_relaxed);
+	ves::g_active_diag->midi_device_delivered_bytes.fetch_add(1, std::memory_order_relaxed);
+}

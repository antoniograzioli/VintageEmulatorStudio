<mamelayout version="2">

<!-- define elements -->

<element name="panel">
    <image file="mu2000.png"/>
</element>


	<element name="led" defstate="0">
		<disk state="0"><color red="0.07" green="0.1" blue="0.02" alpha ="0.0"/></disk>
		<disk state="1"><color red="0.7" green="1.0" blue="0.2" alpha="0.5"/></disk>
	</element>

	<element name="ledred" defstate="0">
		<disk state="0"><color red="0.1" green="0" blue="0.02" alpha ="0.0"/></disk>
		<disk state="1"><color red="1.0" green="0" blue="0.2" alpha="0.5"/></disk>
	</element>

	<element name="ledr" defstate="0">
		<rect state="0"><color red="0.7" green="0.8" blue="0.2" alpha="0.0"/></rect>
		<rect state="1"><color red="0.7" green="1.0" blue="0.2" alpha="0.5"/></rect>
	</element>

	<element name="round_white_button">
		<disk state="0">
			<color red="0.82" green="0.86" blue="0.86" alpha="0.00"/>
		</disk>

		<disk state="0">
			 <color red="0.35" green="0.35" blue="0.35" alpha="0.12"/>
		</disk>
	</element>

	<element name="round_gray_highlight">
		<disk>
			<color red="0.3" green="0.3" blue="0.3" />
		</disk>
	</element>

	<element name="rect_white_button">
		 <!-- Normale: invisibile -->
    <rect state="0">
        <color red="0.82" green="0.86" blue="0.86" alpha="0.00"/>
    </rect>

    <!-- Premuto: leggerissimo grigio -->
    <rect state="1">
        <color red="0.35" green="0.35" blue="0.35" alpha="0.12"/>
    </rect>
	</element>

	<element name="rect_yellow_button">
			 <!-- Normale: invisibile -->
    <rect state="0">
        <color red="0.82" green="0.86" blue="0.86" alpha="0.00"/>
    </rect>

    <!-- Premuto: leggerissimo grigio -->
    <rect state="1">
        <color red="0.35" green="0.35" blue="0.35" alpha="0.12"/>
    </rect>
	</element>

<element name="lcda" defstate="0">
    <rect>
        <color state="0"
               red="0.0"
               green="0.0"
               blue="0.0"
               alpha="0.0" />

        <!-- Highlight molto più delicato -->
        <color state="7"
               red="0.60"
               green="0.66"
               blue="0.40"
               alpha="0.06" />
    </rect>
</element>

<element name="lcdm">
    <rect>
        <!-- Verde oliva più scuro -->
        <color red="0.46"
               green="0.54"
               blue="0.30"
               alpha="0.82" />
    </rect>
</element>
	

	<element name="1_text"><text string="1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="2_text"><text string="2"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="a_d_input_text"><text string="A/D INPUT"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="volume_text"><text string="VOLUME"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="standby_text"><text string="STANDBY"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="on_text"><text string="ON"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="midi_in_a_text"><text string="MIDI IN A"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="phones_text"><text string="PHONES"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="3.3v_text"><text string="3.3V"><color red="0" green="0" blue="0" /></text></element>
	<element name="card_text"><text string="CARD"><color red="0" green="0" blue="0" /></text></element>

	<element name="part_text"><text string="PART"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="bank_pgm_text"><text string="BANK/PGM#"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="vol_text"><text string="VOL"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="exp_text"><text string="EXP"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="pan_text"><text string="PAN"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="rev_text"><text string="REV"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="cho_text"><text string="CHO"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="var_text"><text string="VAR"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="key_text"><text string="KEY"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="xg_text"><text string="XG"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="gs_text"><text string="GS"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="perform_text"><text string="PERFORM"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="select_text"><text string="SELECT"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="audition_text"><text string="AUDITION"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="play_text"><text string="PLAY"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="edit_text"><text string="EDIT"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="util_text"><text string="UTIL"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="effect_text"><text string="EFFECT"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="sampling_text"><text string="SAMPLING"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="seq_text"><text string="SEQ"><color red="0.8" green="0.8" blue="0.8" /></text></element>


	<element name="mu_text"><text string="MU"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="plg1_text"><text string="PLG-1"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="plg2_text"><text string="PLG-2"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="plg3_text"><text string="PLG-3"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="all_text"><text string="ALL"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="mute_text"><text string="MUTE/"><color red="0.2" green="0.2" blue="0.2" /></text></element>
	<element name="solo_text"><text string="SOLO"><color red="0.2" green="0.2" blue="0.2" /></text></element>
	<element name="part_button_text"><text string="PART"><color red="0.2" green="0.2" blue="0.2" /></text></element>

	<element name="enter_text"><text string="ENTER"><color red="0.2" green="0.2" blue="0.2" /></text></element>
	<element name="select_button_text"><text string="SELECT"><color red="0.2" green="0.2" blue="0.2" /></text></element>

	<element name="exit_text"><text string="EXIT"><color red="0.2" green="0.2" blue="0.2" /></text></element>
	<element name="value_text"><text string="VALUE"><color red="0.2" green="0.2" blue="0.2" /></text></element>

	<element name="piano_text"><text string="Piano"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="chrom_perc_text"><text string="Chrom. Perc."><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="organ_text"><text string="Organ"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="guitar_text"><text string="Guitar"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="bass_text"><text string="Bass"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="strings_text"><text string="Strings"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="ensemble_text"><text string="Ensemble"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="brass_text"><text string="Brass"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="reed_text"><text string="Reed"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="pipe_text"><text string="Pipe"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="synth_lead_text"><text string="Synth lead"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="synth_pad_text"><text string="Synth pad"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	<element name="synth_effects_text"><text string="Synth effects"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="ethnic_text"><text string="Ethnic"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="percussive_text"><text string="Percussive"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="sfx_text"><text string="SFX"><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="model_excl_text"><text string="Model excl."><color red="0.8" green="0.8" blue="0.8" /></text></element>
	<element name="drum_text"><text string="Drum"><color red="0.8" green="0.8" blue="0.8" /></text></element>

	


<!-- build screen -->

	<view name="Internal Layout">
		<bounds x="0" y="0" width="1640" height="680" />




    <bounds x="0" y="0" width="1640" height="790"/>

    <!-- Sfondo -->
    <element ref="panel">
        <bounds x="0" y="0" width="1640" height="680"/>
    </element>

   







    <!-- Display -->
   

		<screen index="0"><bounds x="412" y="94" width="700" height="212" /></screen>

		<element name="contrast" ref="lcda" blend="add"><bounds x="412" y="94" width="700" height="212" /></element>

		<element ref="lcdm" blend="multiply"><bounds x="412" y="94" width="700" height="212" /></element>




<!-- LEDS -->



		
		<element name="LED0" ref="led" inputtag="SWS3" inputmask="0x80"><!-- PLAY --><bounds x="1255" y="108" width="30" height="30" /></element>

		
		<element name="LED1" ref="led" inputtag="SWS3" inputmask="0x40"><!-- EDIT --><bounds x="1325" y="108" width="30" height="30" /></element>

		
		<element name="LED2" ref="led" inputtag="SWS3" inputmask="0x20"><!-- UTIL --><bounds x="1255" y="187" width="30" height="30" /></element>

		
		<element name="LED3" ref="led" inputtag="SWS3" inputmask="0x10"><!-- EFFECT --><bounds x="1325" y="187" width="30" height="30" /></element>

		
		<element name="LED4" ref="ledred" inputtag="SWS5" inputmask="0x80"><!-- SAMPLING --><bounds x="1255" y="267" width="30" height="30" /></element>

		
		<element name="LED5" ref="led" inputtag="SWS4" inputmask="0x80"><!-- SEQ --><bounds x="1325" y="267" width="30" height="30" /></element>






		

